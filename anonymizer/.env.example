KAFKA_BROKERS=kafka:9093
KAFKA_TOPIC=http_log
KAFKA_GROUP_ID=logs-anonymizer

# Batching: a batch is flushed when it reaches LOG_BATCH_SIZE records
# or when its oldest record has waited LOG_BATCH_MAX_TIME seconds, whichever comes first
LOG_BATCH_SIZE=100
LOG_BATCH_MAX_TIME=5

CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DIAL_TIMEOUT=5
CLICKHOUSE_READ_TIMEOUT=5
